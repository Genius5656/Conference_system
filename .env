# --- Основные настройки приложения ---
APP_NAME=Конференции.РФ
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Секретный ключ для подписи JWT-токенов.
# В продакшене обязательно замените на случайное значение (например, `openssl rand -hex 32`).
APP_SECRET_KEY=UGHFkjdxhkHDFfuzgHUK275687

# Время жизни сессии (в минутах).
APP_TOKEN_TTL_MINUTES=720

# Флаг Secure выставляйте в true, если приложение доступно по HTTPS.
APP_COOKIE_SECURE=false

# --- Подключение к PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/conference_system
# postgresql+psycopg2://postgres:postgres@localhost:5432/conference_systemsudo

# --- Учётные данные администратора портала (задаются заданием) ---
ADMIN_LOGIN=Conf2027
ADMIN_PASSWORD=Demo77
